# Names only. Leave every value empty. Do not commit credentials.
# Apps read these names from the environment (Worker secrets or local env).
# Person-followable account and faucet steps (no network, no secret values):
#   node scripts/accounts-and-funds.mjs --address <SOLANA_PUBKEY>
#
# Local web (Next): copy to `.env` and `.env.local` at the repo root.
# Deployed Worker: from apps/agent-runtime, pipe values with
#   printf %s "$NAME" | npx wrangler secret put NAME
# Local Worker only: apps/agent-runtime/.dev.vars (gitignored).

# Privy — login, main wallet, additional wallets, server signing
# PRIVY_APP_ID may match NEXT_PUBLIC_PRIVY_APP_ID. PRIVY_APP_SECRET + QUICKNODE_DEVNET_RPC_URL
# are required for POST /api/wallets after email login (otherwise preview wallet rows stay).
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional P-256 key (wallet-auth: prefix). Empty when the app secret alone can sign.
PRIVY_AUTHORIZATION_KEY=
# Public — required for the Connect button in apps/web (loaded from this root file)
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional — only if you created an App client in the Privy dashboard. Wrong values break email login.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Public agent-runtime origin (deployed Worker URL, not localhost:3000)
NEXT_PUBLIC_AGENT_RUNTIME_URL=

# Supabase — Postgres for users, wallets, ledger, approvals, events
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare — Workers, Durable Objects, Browser Rendering
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# OpenRouter — bot loop. The key is an Authorization header only, never part of the prompt.
# Optional model id overrides (not secrets): OPENROUTER_MODEL_RESEARCH, OPENROUTER_MODEL_DECIDE,
# OPENROUTER_MODEL_VERIFY, OPENROUTER_MODEL_MONITOR, OPENROUTER_MODEL_VISION.
OPENROUTER_API_KEY=

# Firecrawl — search and scrape
FIRECRAWL_API_KEY=

# QuickNode — solana-devnet RPC; Streams HMAC; KV wallet list sync
QUICKNODE_DEVNET_RPC_URL=
QUICKNODE_WEBHOOK_SECRET=
QUICKNODE_API_KEY=
QUICKNODE_WALLET_LIST_KEY=

# ElevenLabs Agents — voice. Webhook secret verifies tool and custom-LLM calls.
# Optional model override (not a secret): OPENROUTER_MODEL_VOICE. It must be an x-ai/grok id.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
# Public — mounts the live Talk orb / composer when set
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# x402 price/trust worker. Devnet pubkeys, not secrets. Empty until deploy.
X402_PAY_TO=
X402_FEE_PAYER=
