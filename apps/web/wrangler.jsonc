{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maelstrom-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "maelstrom-web"
    },
    {
      "binding": "AGENT_RUNTIME",
      "service": "maelstrom-agent-runtime"
    }
  ],
  "observability": {
    "enabled": true
  },
  "cache": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "maelstrom.iexdevs.com",
      "custom_domain": true
    }
  ],
  "env": {
    "dev": {
      "name": "maelstrom-web-dev",
      "workers_dev": false,
      "cache": {
        "enabled": true
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "maelstrom-web-dev"
        },
        {
          "binding": "AGENT_RUNTIME",
          "service": "maelstrom-agent-runtime"
        }
      ],
      "routes": [
        {
          "pattern": "dev.maelstrom.iexdevs.com",
          "custom_domain": true
        }
      ]
    }
  }
  // Workers Builds for maelstrom-web (main) and maelstrom-web-dev (dev):
  // root directory apps/web, build cache on, SKIP_DEPENDENCY_INSTALL=true.
  // Build: npm --prefix ../.. run cf:web:build
  //   (one npm ci, then build:worker). Deploy: cf:web:deploy or cf:web:deploy:dev.
  // Those deploy scripts do not install or build again. Cloudflare caches
  // apps/web/.next/cache only when this directory is the build root.
  // Public Next build names live in .env.example: NEXT_PUBLIC_PRIVY_APP_ID,
  // NEXT_PUBLIC_PRIVY_CLIENT_ID, NEXT_PUBLIC_AGENT_RUNTIME_URL.
  // Secret names for this Worker, set with wrangler secret bulk on the top-level
  // worker and again with --env dev: GOOGLE_DRIVE_CLIENT_ID,
  // GOOGLE_DRIVE_CLIENT_SECRET, GOOGLE_DRIVE_REFRESH_TOKEN,
  // QUICKNODE_DEVNET_RPC_URL, QUICKNODE_TESTNET_RPC_URL (chat get_wallets enrich).
  // Do not put PRIVY_APP_SECRET or any other secret value in this file.
}
