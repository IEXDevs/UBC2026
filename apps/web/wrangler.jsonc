{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maelstrom-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "maelstrom-web"
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "maelstrom.iexdevs.com",
      "custom_domain": true
    }
  ]
  // Public Next build names live in .env.example: NEXT_PUBLIC_PRIVY_APP_ID,
  // NEXT_PUBLIC_PRIVY_CLIENT_ID, NEXT_PUBLIC_AGENT_RUNTIME_URL.
  // Do not put PRIVY_APP_SECRET or any other secret value in this file.
}
